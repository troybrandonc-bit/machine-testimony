{
  // How this site is deployed, kept beside the site rather than in a
  // dashboard field, so the deploy is reproducible by anyone with the repo.
  //
  // There is no Worker code here and no `main`: an assets-only Worker serves
  // the files as they sit. Nothing compiles, so a deploy can fail for exactly
  // one reason, a wrong directory, and that is the point.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "machine-testimony",
  "compatibility_date": "2026-09-02",
  // The site lives in public/ rather than at the root, so what gets published
  // is exactly what is meant to be. Pointing this at the repository root read
  // 108 files out of a directory holding eight, because git internals and the
  // readme are also files.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
